# ============================================================
# 博客生成 Agent - 后端环境变量模板
# 使用方式：复制本文件为 .env 并填写真实值
#   cp .env.example .env
# 注意：.env 包含密钥，不要提交到版本库（已加入 .gitignore）
# ============================================================

# ========== LLM 基础配置（必填）==========
# 模型服务地址（阿里云百炼 OpenAI 兼容接口）
llm_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼 API Key（必填，https://bailian.console.aliyun.com/ 获取）
llm_api_key=your_llm_api_key_here
# 默认模型（各 Agent 未单独配置时使用）
llm_model=qwen-plus
# 默认温度（0-1，越高越有创造性）
llm_temperature=0.7
# 千问自带联网搜索全局开关（调研节点会强制开启联网，不受此开关影响）
llm_enable_search=false

# ========== 各 Agent 模型配置（可选，不填则用默认 llm_model）==========
# 调研员：速度快、便宜，建议用 qwen-turbo / qwen-flash
llm_model_researcher=qwen-flash
# 大纲师：平衡质量和速度，建议用 qwen-plus / qwen-flash
llm_model_outliner=qwen-flash
# 写手：正文生成需要质量，建议用 qwen-plus
llm_model_writer=qwen-plus
# 审稿：需要最强的推理和判断能力，建议用 qwen-max（更强的模型审稿更严格）
llm_model_reviewer=qwen-max
# 排版师：简单任务，用便宜的，建议用 qwen-turbo / qwen-flash
llm_model_formatter=qwen-flash

# ========== 审稿配置 ==========
# 是否启用审稿循环（true=写完后审稿+修改，质量更高但更慢；false=写完直接配图格式化，速度更快）
enable_review=true
# 审稿不通过时，最多自动修改几次（建议2次，避免死循环和太慢）
max_review_rounds=2

# ========== 配图配置 ==========
# 配图方式在人工介入点1由用户选择：api（搜索图片）或 ai（AI生成图片）

# 方式A：图片网站API（搜索免费正版图片，二选一或都填）
# Pexels API Key（推荐，免费额度大）：https://www.pexels.com/api/
pexels_api_key=your_pexels_api_key_here
# Unsplash API Key（备选）：https://unsplash.com/developers
unsplash_access_key=your_unsplash_access_key_here

# 方式B：AI生成图片（百炼 qwen-image-3.0 / 通义万相）
# 图片生成模型：qwen-image-3.0-pro（高质量）/ qwen-image-3.0（标准）/ wanx2.1-t2i-turbo（旧版快速）
image_gen_model=qwen-image-3.0-pro
# 配图专用API Key（不填则用上面的 llm_api_key）
image_api_key=your_image_api_key_here
# 百炼业务空间ID（qwen-image-3.0 必需，在百炼控制台→业务空间详情页查看）
dashscope_workspace_id=your_dashscope_workspace_id_here

# ========== Database ==========
# 本地直接运行时用相对路径；docker-compose 启动时会自动覆盖为持久化卷路径
db_url=sqlite:///./blog_agent.db

# ========== Celery Redis（暂未使用，预留）==========
redis_broker_url=redis://127.0.0.1:6379/0
redis_result_backend=redis://127.0.0.1:6379/0

# ========== Agent ==========
agent_timeout=120
