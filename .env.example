# ============================================================
# PostgreSQL 配置模板（docker-compose 变量替换专用）
# 部署方法：复制本文件为 .env 并修改真实密码
#   cp .env.example .env
# 注意：.env 会被 .gitignore 忽略，密码不会进入版本库
# ============================================================
POSTGRES_USER=blog
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=blog_agent
# docker 容器间通信用服务名 postgres；本机直接调试时可改 localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
