# ============================================================
# backend_L 环境变量模板
# 用法：cp .env.example .env，然后填入真实值
# 生产环境严禁提交 .env；密钥走服务器 secrets（如 /etc/blog-agent/backend_L.env）
# ============================================================

# ========== LLM 基础配置 ==========
llm_base_url=
llm_api_key=
llm_model=qwen3.7-plus-2026-05-26
llm_temperature=0.7
llm_enable_search=false

# ========== 各 Agent 模型配置（可选，不填则用默认 llm_model）==========
llm_model_researcher=
llm_model_title=
llm_model_outliner=
llm_model_writer=
llm_model_reviewer=
llm_model_image=

# ========== 审稿配置 ==========
enable_review=true
max_review_rounds=2

# ========== 配图配置 ==========
pexels_api_key=
unsplash_access_key=
image_gen_model=qwen-image-3.0-pro
image_api_key=
dashscope_workspace_id=

# ========== 数据库 ==========
# 开发环境指向 compose 内网服务名 postgresl；生产指向真实实例
db_url=

# ========== Celery Redis（预留）==========
redis_broker_url=redis://127.0.0.1:6379/0
redis_result_backend=redis://127.0.0.1:6379/0

# ========== 运行时 ==========
agent_timeout=120

# ========== 用户认证 ==========
# JWT 签名密钥（生产必须用随机强密钥，严禁使用默认值）
jwt_secret=
jwt_algorithm=HS256
jwt_expire_minutes=10080
# 开发环境的注册测试码与模拟充值确认码。生产环境使用随机邮箱验证码，并关闭模拟充值。
email_code_default=888888

# ========== 注册 / 邮箱（生产 Compose 强制 app_env=production）==========
APP_ENV=development
registration_mode=auto
smtp_host=
smtp_port=465
smtp_transport=ssl
smtp_sender=
smtp_username=
smtp_password=
auth_login_per_ip=30
auth_register_per_ip=5
auth_send_per_ip=12

# ========== 免费计划与共享队列 ==========
free_daily_units=10
site_daily_units=100
free_daily_drafts=20
free_max_active_jobs=1
agent_max_workers=4
agent_max_queued_jobs=64
agent_job_lease_seconds=90
agent_job_max_runtime_seconds=1800
agent_job_max_attempts=2
agent_queue_poll_seconds=1.0

# ========== 单阶段供应商预算 ==========
MODEL_LIMIT_ENABLED=true
MODEL_LIMIT_AI_IMAGES_ENABLED=true
MODEL_LIMIT_MODEL_CALLS=24
MODEL_LIMIT_TOOL_REQUESTS=40
MODEL_LIMIT_IMAGES=3
MODEL_LIMIT_STAGE_SECONDS=600
MODEL_LIMIT_REQUEST_SECONDS=90
MODEL_LIMIT_SDK_RETRIES=0
MODEL_LIMIT_INPUT_BYTES=192000
MODEL_LIMIT_OUTPUT_TOKENS=8192
MODEL_LIMIT_IMAGE_BYTES=8388608

# ========== 容器编排（docker-compose.dev.yml 使用）==========
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
